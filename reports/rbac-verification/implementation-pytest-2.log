        entry.write_text(
            (
                "const fs=require('fs'),cp=require('child_process'); "
                "fs.mkdirSync('dist',{recursive:true}); const "
                "p=cp.spawn(process.execPath,['-e','setInterval(()=>{},1000)'],{st"
                "dio:'ignore'}); "
